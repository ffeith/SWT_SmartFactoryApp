<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MyAvaloniaApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="MyAvaloniaApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="900"
        Height="500"
        Title="MyAvaloniaApp">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid> 
     <Image Source="avares://MyAvaloniaApp/Assets/factory_plan.png" 
           Stretch="None"/> 
  
    <Canvas x:Name="canvasFactory" HorizontalAlignment="Left" Height="600" VerticalAlignment="Top" Width="900" > 
       
        <Grid Height="95" Width="200" Canvas.Left="970" Canvas.Top="500"> 
            <Button x:Name="UpButton" Content="Up" HorizontalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" Width="65" FontSize="14" Click="MoveUp_Click" /> 
            <Button x:Name="DownButton" Content="Down" HorizontalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="65" FontSize="14" Click="MoveDown_Click"/> 
            <Button x:Name="LeftButton" Content="Left" HorizontalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Center" Width="65" FontSize="14" Click="MoveLeft_Click" /> 
            <Button x:Name="RightButton" Content="Right" HorizontalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Center" Width="65" FontSize="14" Click="MoveRight_Click" />          
            <Button x:Name="UpLeftButton" Content="UpL" HorizontalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Top" Width="65" FontSize="14" Click="MoveUpLeft_Click" />
            <Button x:Name="UpRightButton" Content="UpR" HorizontalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Top" Width="65" FontSize="14" Click="MoveUpRight_Click" />
            <Button x:Name="DownLeftButton" Content="DownL" HorizontalContentAlignment="Center" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="65" FontSize="14" Click="MoveDownLeft_Click" />
            <Button x:Name="DownRightButton" Content="DownR" HorizontalContentAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="65" FontSize="14" Click="MoveDownRight_Click" />
            <Button x:Name="StopButton" Content="Stop" HorizontalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Width="65" FontSize="14" Click="StopButton_Click" />
        </Grid>
        <Grid Height="30" Width="200" Canvas.Left="970" Canvas.Top="600">
            <Button x:Name="TurnLeft" Content="Turn L" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Width="65" Click="TurnLeft_Click" />
            <Button x:Name="TurnRight" Content="Turn R" HorizontalContentAlignment="Center" HorizontalAlignment="Right" Width="65" Click="TurnRight_Click" />
            <Button x:Name="TurnToZeroDegrees" Content="0°" HorizontalContentAlignment="Center" HorizontalAlignment="Center" Width="65" Click="TurnToZeroDegrees_Click" />
        </Grid>
        <Button x:Name="UndockButton" Content="Undock" Width="150" Canvas.Left="970" Canvas.Top="705" Click="Undock_Click" />
        <StackPanel
            Canvas.Left="970"
            Canvas.Top="630"
            Spacing="2">

            <RadioButton
                GroupName="RobotMovementMode"
                Content="Schrittbewegung"
                IsChecked="{Binding IsStepMovementSelected, Mode=TwoWay}" />

            <RadioButton
                GroupName="RobotMovementMode"
                Content="Kontinuierliche Bewegung"
                IsChecked="{Binding IsContinuousMovementSelected, Mode=TwoWay}" />

        </StackPanel>
        <TextBlock
            Text="{Binding UndockInfo}"
            Width="230"
            TextWrapping="Wrap"
            Canvas.Left="970"
            Canvas.Top="180" />
        <Grid Height="30" Width="200" Canvas.Left="970" Canvas.Top="450">
            <Button x:Name="TimerStart" Content="Start" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Width="96" Click="TimerStart_Click" />
            <Button x:Name="TimerStop" Content="Stop" HorizontalContentAlignment="Center" HorizontalAlignment="Right" Width="96" Click="TimerStop_Click" />
        </Grid>
        <Rectangle x:Name="ProductionLineRed" Width="{Binding ProductionLineWidth}" Height="{Binding ProductionLineHeight}" Stroke="Black" Canvas.Left="{Binding ProductionLineRed.ProductionLinePose.X}" Canvas.Top="{Binding ProductionLineRed.ProductionLinePose.Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding ProductionLineRed.ProductionLinePose.Angle}" />
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <ImageBrush Source="avares://MyAvaloniaApp/Assets/ProductionLineRed.jpeg" />
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ProductionLineBlue" Width="{Binding ProductionLineWidth}" Height="{Binding ProductionLineHeight}" Stroke="Black" Canvas.Left="{Binding ProductionLineBlue.ProductionLinePose.X}" Canvas.Top="{Binding ProductionLineBlue.ProductionLinePose.Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding ProductionLineBlue.ProductionLinePose.Angle}" />
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <ImageBrush Source="avares://MyAvaloniaApp/Assets/ProductionLineBlue.jpeg" />
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ProductionLineYellow" Width="{Binding ProductionLineWidth}" Height="{Binding ProductionLineHeight}" Stroke="Black" Canvas.Left="{Binding ProductionLineYellow.ProductionLinePose.X}" Canvas.Top="{Binding ProductionLineYellow.ProductionLinePose.Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding ProductionLineYellow.ProductionLinePose.Angle}" />
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <ImageBrush Source="avares://MyAvaloniaApp/Assets/ProductionLineYellow.jpeg" />
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ProductionLineGreen" Width="{Binding ProductionLineWidth}" Height="{Binding ProductionLineHeight}" Stroke="Black" Canvas.Left="{Binding ProductionLineGreen.ProductionLinePose.X}" Canvas.Top="{Binding ProductionLineGreen.ProductionLinePose.Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding ProductionLineGreen.ProductionLinePose.Angle}" />
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <ImageBrush Source="avares://MyAvaloniaApp/Assets/ProductionLineGreen.jpeg" />
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ProductionLineRecycle" Width="{Binding RecycleLineWidth}" Height="{Binding RecycleLineHeight}" Stroke="Black" Canvas.Left="{Binding ProductionLineRecycle.ProductionLinePose.X}" Canvas.Top="{Binding ProductionLineRecycle.ProductionLinePose.Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding ProductionLineRecycle.ProductionLinePose.Angle}" />
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <ImageBrush Source="avares://MyAvaloniaApp/Assets/ProductionLineRecycle.png" />
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ProductionLineDelivery" Width="{Binding DeliveryLineWidth}" Height="{Binding DeliveryLineHeight}" Stroke="Black" Canvas.Left="{Binding ProductionLineDelivery.ProductionLinePose.X}" Canvas.Top="{Binding ProductionLineDelivery.ProductionLinePose.Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding ProductionLineDelivery.ProductionLinePose.Angle}" />
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <ImageBrush Source="avares://MyAvaloniaApp/Assets/ProductionLineDelivery.png" />
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="CustomerArrow" Width="{Binding CustomerArrowWidth}" Height="{Binding CustomerArrowHeight}" Stroke="Black" Canvas.Left="{Binding CustomerArrowX}" Canvas.Top="{Binding CustomerArrowY}">
            <Rectangle.Fill>
                <ImageBrush Source="avares://MyAvaloniaApp/Assets/CustomerArrow.png" />
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="RecyclingArrow" Width="{Binding RecyclingArrowWidth}" Height="{Binding RecyclingArrowHeight}" Stroke="Black" Canvas.Left="{Binding RecyclingArrowX}" Canvas.Top="{Binding RecyclingArrowY}">
        <Rectangle.Fill>
            <ImageBrush Source="avares://MyAvaloniaApp/Assets/RecyclingArrow.png"/>
        </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="brickRed1" Width="{Binding BricksView[0].Width}" Height="{Binding BricksView[0].Height}" Fill="Red" Stroke="Black" Canvas.Left="{Binding BricksView[0].X}" Canvas.Top="{Binding BricksView[0].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[0].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickRed2" Width="{Binding BricksView[1].Width}" Height="{Binding BricksView[1].Height}" Fill="Red" Stroke="Black" Canvas.Left="{Binding BricksView[1].X}" Canvas.Top="{Binding BricksView[1].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[1].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickRed3" Width="{Binding BricksView[2].Width}" Height="{Binding BricksView[2].Height}" Fill="Red" Stroke="Black" Canvas.Left="{Binding BricksView[2].X}" Canvas.Top="{Binding BricksView[2].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[2].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickRed4" Width="{Binding BricksView[3].Width}" Height="{Binding BricksView[3].Height}" Fill="Red" Stroke="Black" Canvas.Left="{Binding BricksView[3].X}" Canvas.Top="{Binding BricksView[3].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[3].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickYellow1" Width="{Binding BricksView[4].Width}" Height="{Binding BricksView[4].Height}" Fill="Yellow" Stroke="Black" Canvas.Left="{Binding BricksView[4].X}" Canvas.Top="{Binding BricksView[4].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[4].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickYellow2" Width="{Binding BricksView[5].Width}" Height="{Binding BricksView[5].Height}" Fill="Yellow" Stroke="Black" Canvas.Left="{Binding BricksView[5].X}" Canvas.Top="{Binding BricksView[5].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[5].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickYellow3" Width="{Binding BricksView[6].Width}" Height="{Binding BricksView[6].Height}" Fill="Yellow" Stroke="Black" Canvas.Left="{Binding BricksView[6].X}" Canvas.Top="{Binding BricksView[6].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[6].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickYellow4" Width="{Binding BricksView[7].Width}" Height="{Binding BricksView[7].Height}" Fill="Yellow" Stroke="Black" Canvas.Left="{Binding BricksView[7].X}" Canvas.Top="{Binding BricksView[7].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[7].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickBlue1" Width="{Binding BricksView[8].Width}" Height="{Binding BricksView[8].Height}" Fill="Blue" Stroke="Black" Canvas.Left="{Binding BricksView[8].X}" Canvas.Top="{Binding BricksView[8].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[8].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickBlue2" Width="{Binding BricksView[9].Width}" Height="{Binding BricksView[9].Height}" Fill="Blue" Stroke="Black" Canvas.Left="{Binding BricksView[9].X}" Canvas.Top="{Binding BricksView[9].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[9].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickBlue3" Width="{Binding BricksView[10].Width}" Height="{Binding BricksView[10].Height}" Fill="Blue" Stroke="Black" Canvas.Left="{Binding BricksView[10].X}" Canvas.Top="{Binding BricksView[10].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[10].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickBlue4" Width="{Binding BricksView[11].Width}" Height="{Binding BricksView[11].Height}" Fill="Blue" Stroke="Black" Canvas.Left="{Binding BricksView[11].X}" Canvas.Top="{Binding BricksView[11].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[11].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickGreen1" Width="{Binding BricksView[12].Width}" Height="{Binding BricksView[12].Height}" Fill="Green" Stroke="Black" Canvas.Left="{Binding BricksView[12].X}" Canvas.Top="{Binding BricksView[12].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[12].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickGreen2" Width="{Binding BricksView[13].Width}" Height="{Binding BricksView[13].Height}" Fill="Green" Stroke="Black" Canvas.Left="{Binding BricksView[13].X}" Canvas.Top="{Binding BricksView[13].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[13].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickGreen3" Width="{Binding BricksView[14].Width}" Height="{Binding BricksView[14].Height}" Fill="Green" Stroke="Black" Canvas.Left="{Binding BricksView[14].X}" Canvas.Top="{Binding BricksView[14].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[14].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle x:Name="brickGreen4" Width="{Binding BricksView[15].Width}" Height="{Binding BricksView[15].Height}" Fill="Green" Stroke="Black" Canvas.Left="{Binding BricksView[15].X}" Canvas.Top="{Binding BricksView[15].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[15].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <StackPanel
            Canvas.Left="970"
            Canvas.Top="220"
            Spacing="6">

            <TextBlock
                Text="Erfolgreich gelieferte Steine:"
                FontWeight="Bold" />

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Rot:" />
                <TextBlock Text="{Binding RedDelivered}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Blau:" />
                <TextBlock Text="{Binding BlueDelivered}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Grün:" />
                <TextBlock Text="{Binding GreenDelivered}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Gelb:" />
                <TextBlock Text="{Binding YellowDelivered}" />
            </StackPanel>

        </StackPanel>

        <!--
        <Rectangle
            x:Name="brickRecycle1"
            Width="{Binding BricksView[16].Width}"
            Height="{Binding BricksView[16].Height}"
            Fill="Yellow"
            Stroke="Black"
            Canvas.Left="{Binding BricksView[16].X}"
            Canvas.Top="{Binding BricksView[16].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[16].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>

        <Rectangle
            x:Name="brickRecycle2"
            Width="{Binding BricksView[17].Width}"
            Height="{Binding BricksView[17].Height}"
            Fill="Red"
            Stroke="Black"
            Canvas.Left="{Binding BricksView[17].X}"
            Canvas.Top="{Binding BricksView[17].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[17].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>

        <Rectangle
            x:Name="brickRecycle3"
            Width="{Binding BricksView[18].Width}"
            Height="{Binding BricksView[18].Height}"
            Fill="Green"
            Stroke="Black"
            Canvas.Left="{Binding BricksView[18].X}"
            Canvas.Top="{Binding BricksView[18].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[18].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>

        <Rectangle
            x:Name="brickRecycle4"
            Width="{Binding BricksView[19].Width}"
            Height="{Binding BricksView[19].Height}"
            Fill="Blue"
            Stroke="Black"
            Canvas.Left="{Binding BricksView[19].X}"
            Canvas.Top="{Binding BricksView[19].Y}">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding BricksView[19].Angle}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        -->

        <Rectangle x:Name="robotRectangle" Width="{Binding RobotWidth}" Height="{Binding RobotHeight}" Stroke="Black" Canvas.Left="{Binding RobotX}" Canvas.Top="{Binding RobotY}" >
            <Rectangle.Fill>
                <ImageBrush Source="avares://MyAvaloniaApp/Assets/robotV3.png" />
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <RotateTransform Angle="{Binding Rotation}" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <TextBox x:Name="PositionTextBoxX" Canvas.Left="100" Canvas.Top="100" Width="20" IsReadOnly="True" Text="{Binding RobotX}" />
        <TextBox x:Name="PositionTextBoxY" Canvas.Left="100" Canvas.Top="150" Width="20" IsReadOnly="True" Text="{Binding RobotY}" />
        <TextBox x:Name="RotationTextBox" Canvas.Left="100" Canvas.Top="200" Width="20" IsReadOnly="True" Text="{Binding Rotation}" />
    </Canvas>
   
</Grid>

</Window>